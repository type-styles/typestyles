---
import Head from '../components/Head.astro';
import SkipLink from '../components/SkipLink.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SearchPalette from '../components/SearchPalette.astro';
import {
  designStyleList,
  docsAppearanceClassesToClear,
  getDocsAppearanceClass,
  type DesignStyleId,
} from '../tokens';
import { playground } from '../styles/playground';

type Props = {
  title?: string;
};

const { title = 'Playground — typestyles' } = Astro.props;

const typestylesCssHref = `${import.meta.env.BASE_URL}typestyles.css`;

const appearanceMap = Object.fromEntries(
  designStyleList.map(({ id }) => [id, getDocsAppearanceClass(id, 'light')]),
) as Record<
  DesignStyleId,
  { className: string; dataMode: 'light' | 'dark' | undefined; dataStyle: DesignStyleId }
>;

const appearanceBootstrap = {
  clear: docsAppearanceClassesToClear.filter(Boolean),
  map: appearanceMap,
};
---

<html lang="en">
  <head>
    <Head title={title} appearanceBootstrap={appearanceBootstrap} typestylesCssHref={typestylesCssHref} />
    <!-- Static copy from build-playground-assets (monaco package exports block CSS imports). -->
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}playground/monaco-editor.css`} />
  </head>
  <body>
    <div transition:persist="docs-skip">
      <SkipLink />
    </div>
    <SiteHeader appearanceBootstrap={appearanceBootstrap} hideMenuToggle />
    <SearchPalette />
    <div class={playground.page} data-playground>
      <slot />
    </div>
  </body>
</html>
